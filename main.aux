\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces Experiment 3: SHAP Feature Attribution Accuracy. P@k = Precision at $k$ (fraction of top-$k$ features that are truly drifted); R@k = Recall at $k$ (fraction of drifted features in top-$k$); F1@k = harmonic mean. DSI = AUC $\times $ (1 $-$ $H_{\text  {norm}}(\mathbf  {s})$); higher DSI indicates more concentrated, severe drift. All DSI values fall in the Low tier ($< 0.3$). In the Prescription column, $\text  {$\mathsurround \z@ \mathchar "558$}$ indicates that the automated SHAP-based drift-type classification correctly matched the ground-truth drift scenario.}}{57}{table.caption.19}\protected@file@percent }
\newlabel{tab:exp3-results}{{4.4}{57}{Experiment 3: SHAP Feature Attribution Accuracy. P@k = Precision at $k$ (fraction of top-$k$ features that are truly drifted); R@k = Recall at $k$ (fraction of drifted features in top-$k$); F1@k = harmonic mean. DSI = AUC $\times $ (1 $-$ $H_{\text {norm}}(\mathbf {s})$); higher DSI indicates more concentrated, severe drift. All DSI values fall in the Low tier ($< 0.3$). In the Prescription column, $\checkmark $ indicates that the automated SHAP-based drift-type classification correctly matched the ground-truth drift scenario}{table.caption.19}{}}
