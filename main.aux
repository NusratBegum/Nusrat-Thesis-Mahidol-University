\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces Experiment 3: SHAP Feature Attribution Accuracy. P@k = Precision at $k$ (fraction of top-$k$ features that are truly drifted); R@k = Recall at $k$ (fraction of drifted features in top-$k$); F1@k = harmonic mean. DSI = AUC $\times $ (1 $-$ $H_{\text  {norm}}(\mathbf  {s})$); higher DSI indicates more concentrated, severe drift. All DSI values fall in the Low tier ($< 0.3$). In the Prescription column, $\text  {$\mathsurround \z@ \mathchar "558$}$ indicates that the automated SHAP-based drift-type classification correctly matched the ground-truth drift scenario.}}{63}{table.caption.118}\protected@file@percent }
\newlabel{tab:exp3-results}{{4.5}{63}{Experiment 3: SHAP Feature Attribution Accuracy. P@k = Precision at $k$ (fraction of top-$k$ features that are truly drifted); R@k = Recall at $k$ (fraction of drifted features in top-$k$); F1@k = harmonic mean. DSI = AUC $\times $ (1 $-$ $H_{\text {norm}}(\mathbf {s})$); higher DSI indicates more concentrated, severe drift. All DSI values fall in the Low tier ($< 0.3$). In the Prescription column, $\checkmark $ indicates that the automated SHAP-based drift-type classification correctly matched the ground-truth drift scenario}{table.caption.118}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.7}{\ignorespaces Combined bell curve and SHAP attribution analysis for three controlled scenarios. Top: Univariate drift---F3 dominates at 52.3\%. Middle: Subset drift---F5, F2, F7 collectively account for 65\%. Bottom: Multivariate drift---importance distributed evenly, max 14.6\%.}}{65}{figure.caption.119}\protected@file@percent }
\newlabel{fig:shap-combined}{{4.7}{65}{Combined bell curve and SHAP attribution analysis for three controlled scenarios. Top: Univariate drift---F3 dominates at 52.3\%. Middle: Subset drift---F5, F2, F7 collectively account for 65\%. Bottom: Multivariate drift---importance distributed evenly, max 14.6\%}{figure.caption.119}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.8}{\ignorespaces Top: SHAP attribution accuracy across all three scenarios (P@k = R@k = F1@k = 1.0 for all). Bottom: Diagnostic capability comparison---EADD is the only detector providing feature-level attribution and automated prescriptions.}}{66}{figure.caption.120}\protected@file@percent }
