\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Detailed architecture of the Enhanced Adversarial Drift Detection (EADD) methodology, matching the pipeline design used in the JCSEE paper: adaptive windowing, discriminative detection, ASPT significance gating, and SHAP+DSI diagnostics.}}{28}{figure.caption.53}\protected@file@percent }
\newlabel{fig:methodology-detailed-architecture}{{3.2}{28}{Detailed architecture of the Enhanced Adversarial Drift Detection (EADD) methodology, matching the pipeline design used in the JCSEE paper: adaptive windowing, discriminative detection, ASPT significance gating, and SHAP+DSI diagnostics}{figure.caption.53}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces Detailed flowchart of the EADD methodology with mathematical formalisms. The process flows from data windowing (1), through discriminative classification (2) and performance measurement (3), to statistical validation via ASPT. If drift is significant, the framework proceeds to SHAP-based diagnosis and severity scoring with DSI, culminating in an actionable MLOps report and prescription. Pipeline components map to three thesis contributions: Contributions~1--2 ($H_{\text  {pred}}$ and ASPT) form Contribution~1; Contributions~3--4 (SHAP Localisation and DSI) form Contribution~2; Contribution~3 is the comprehensive experimental evaluation.}}{29}{figure.caption.54}\protected@file@percent }
\newlabel{fig:methodology-mathematical-flowchart}{{3.3}{29}{Detailed flowchart of the EADD methodology with mathematical formalisms. The process flows from data windowing (1), through discriminative classification (2) and performance measurement (3), to statistical validation via ASPT. If drift is significant, the framework proceeds to SHAP-based diagnosis and severity scoring with DSI, culminating in an actionable MLOps report and prescription. Pipeline components map to three thesis contributions: Contributions~1--2 ($H_{\text {pred}}$ and ASPT) form Contribution~1; Contributions~3--4 (SHAP Localisation and DSI) form Contribution~2; Contribution~3 is the comprehensive experimental evaluation}{figure.caption.54}{}}
